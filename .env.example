# =============================================================================
# Grace High School — environment variables
# Copy to `.env` for local development. Set the same keys in Coolify (runtime).
# =============================================================================

# --- Production (Coolify on gracehighschoolgayaza.academy) ---
# One deploy serves:
#   Public site     https://gracehighschoolgayaza.academy/
#   Staff dashboard https://gracehighschoolgayaza.academy/dashboard/
#   API (same host) https://gracehighschoolgayaza.academy/api/...
# Dashboard UI: artifacts/grace-admin (News, Gallery, Resources, …) — not Render.
#
# Required on the Coolify app:
#   DATABASE_URL, SESSION_SECRET, ALLOWED_ORIGINS (see nixpacks.toml defaults)
# Programmatic setup: node scripts/coolify-sync-production.mjs

# --- Required (production / Coolify runtime) ---
# PostgreSQL connection string (Coolify: create PostgreSQL → copy internal URL → app env DATABASE_URL).
# Without this, https://gracehighschoolgayaza.academy/dashboard/ cannot save gallery/news/etc.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grace_high_school
# Coolify internal Postgres usually needs PGSSL=false (default in scripts/coolify-sync-production.mjs).
# PGSSL=false

# Long random string; keeps staff sessions valid across redeploys.
SESSION_SECRET=local-dev-session-secret

# Comma-separated browser origins allowed to call /api with credentials.
# ALLOWED_ORIGINS=https://gracehighschoolgayaza.academy,https://www.gracehighschoolgayaza.academy

# --- Required on first boot only (seed admin if none exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GraceAdmin123
# Force-reset admin password from env once (optional):
# ADMIN_SYNC_PASSWORD=true

# --- Runtime (Coolify usually sets these) ---
NODE_ENV=development
# PORT=8080
# LOG_LEVEL=info

# --- Optional ---
# PASSWORD_RESET_SECRET=change-me-recovery-code
# PGSSL=true
# LOCAL_UPLOAD_DIR=.local/uploads
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
# REPLIT_DOMAINS=
# REPL_ID=

# --- Local dev only (not needed on Coolify) ---
# API server port when running api-server locally:
PORT=8080
# Where Vite dev proxies /api (pnpm dev:admin / dev:site):
API_PROXY_TARGET=http://localhost:8080

# --- Coolify / Nixpacks (leave custom install/build/start empty — use nixpacks.toml) ---
# Build:    pnpm run build:docker  (api-server + public site + dashboard)
# Start:    NODE_ENV=production node ./scripts/src/docker-start.mjs
# Health:   /healthz  ·  DB check: /api/readyz
#
# Do NOT set NODE_ENV=production during the build phase — pnpm would skip devDependencies.
#
# Frontends use same-origin /api (VITE_API_BASE_URL unset in .env.production).
